---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, translator, type Locale } from '../i18n/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const current = languages.find((language) => language.code === locale)!;
const t = translator(locale);
---
<details class="language-switcher">
  <summary aria-label={t('languageLabel')} title={t('languageLabel')}>
    <span aria-hidden="true">{current.flag}</span>
  </summary>
  <ul class="language-options">
    {languages.map((language) => (
      <li><a href={getRelativeLocaleUrl(language.code)} lang={language.code} hreflang={language.code} aria-current={language.code === locale ? 'page' : undefined}>
        <span aria-hidden="true">{language.flag}</span><span>{language.name}</span>
      </a></li>
    ))}
  </ul>
</details>
<script>
  const switcher = document.querySelector<HTMLDetailsElement>('.language-switcher');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let animations: Animation[] = [];
  const stop = () => {
    animations.forEach((animation) => animation.cancel());
    animations = [];
  };
  switcher?.addEventListener('toggle', () => {
    stop();
    if (!switcher.open || reducedMotion.matches || document.documentElement.dataset.motion === 'off') return;
    const menu = switcher.querySelector<HTMLElement>('.language-options');
    if (!menu) return;
    animations.push(menu.animate(
      [{ opacity: 0, transform: 'translateY(-8px) scale(.97)' }, { opacity: 1, transform: 'translateY(0) scale(1)' }],
      { duration: 220, easing: 'cubic-bezier(.16, 1, .3, 1)' },
    ));
    menu.querySelectorAll('li').forEach((item, index) => {
      animations.push(item.animate(
        [{ opacity: 0, transform: 'translateY(5px)' }, { opacity: 1, transform: 'translateY(0)' }],
        { duration: 180, delay: 35 * index, fill: 'backwards', easing: 'ease-out' },
      ));
    });
  });
  const respectMotion = () => {
    if (reducedMotion.matches || document.documentElement.dataset.motion === 'off') stop();
  };
  reducedMotion.addEventListener('change', respectMotion);
  new MutationObserver(respectMotion).observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] });
  window.addEventListener('pagehide', stop);
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !switcher?.contains(event.target)) switcher?.removeAttribute('open');
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && switcher?.open) {
      switcher.open = false;
      switcher.querySelector('summary')?.focus();
    }
  });
</script>
